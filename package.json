{
  "name": "take-a-moment",
  "version": "0.6.6",
  "description": "A gentle Windows break-reminder app",
  "main": "out/main/main.js",
  "scripts": {
    "predev": "node scripts/gen-assets.cjs",
    "dev": "electron-vite dev",
    "build": "node scripts/gen-assets.cjs && electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.76",
    "framer-motion": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^24.9.0",
    "electron-vite": "^2.1.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "app.take-a-moment",
    "productName": "Take A Moment",
    "copyright": "Copyright © 2026 Take A Moment",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app-full.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Take A Moment",
      "uninstallDisplayName": "Take A Moment",
      "runAfterFinish": true,
      "installerIcon": "assets/icons/app.ico",
      "uninstallerIcon": "assets/icons/app.ico",
      "language": "1053",
      "include": "build/installer.nsh"
    }
  }
}
